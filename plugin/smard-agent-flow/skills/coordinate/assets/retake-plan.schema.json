{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blockers",
    "options",
    "criteria",
    "matrix",
    "fronts",
    "roles",
    "done_when",
    "cost",
    "risks",
    "reviewer_findings"
  ],
  "properties": {
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "scores"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "scores": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          }
        }
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "weight"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "winner",
        "margin_pct",
        "loses_on"
      ],
      "properties": {
        "method": {
          "enum": [
            "engine",
            "inline"
          ]
        },
        "winner": {
          "type": "string",
          "minLength": 1
        },
        "margin_pct": {
          "type": "number",
          "minimum": 0
        },
        "loses_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "fronts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "tasks"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "deliverable",
                "proof",
                "executor"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "deliverable": {
                  "type": "string",
                  "minLength": 1
                },
                "proof": {
                  "type": "string",
                  "minLength": 1
                },
                "executor": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "who",
          "model",
          "rule"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "who": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "done_when": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "milestone",
          "condition"
        ],
        "properties": {
          "milestone": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measured",
        "statement"
      ],
      "properties": {
        "measured": {
          "type": "boolean"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewer_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retake-plan.schema.json",
  "title": "retake-plan",
  "description": "Retake plan: blockers, weighted option matrix, fronts with proofs, roles, completion conditions, cost, risks."
}
